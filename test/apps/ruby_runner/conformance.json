{
  "runtime": "ruby",
  "sdk_lang": 5,
  "command": {
    "test": "ruby {artifact} {namespace}",
    "bench": "ruby --yjit {artifact} {namespace}"
  },
  "artifacts": {
    "test": [
      "runner.rb"
    ],
    "bench": [
      "runner.rb"
    ]
  },
  "build": {
    "test": "scripts/build-ruby-sdk.sh",
    "bench": "scripts/build-ruby-sdk.sh --release"
  },
  "connect_timeout_ms": 60000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "thread-pool",
    "detail": "A base pool of Ruby threads each looping poll/dispatch/complete on itself, plus a supervisor parked in the starvation wait; the GVL is released around every blocking core call.",
    "env": {
      "FLEZHA_WORKER_POOL_SIZE": "base worker threads (default: the host's processor count)",
      "FLEZHA_WORKER_POOL_MAX": "the ceiling the starvation supervisor grows to (default: ten times the base)",
      "FLEZHA_RUBY_EXECUTOR": "which executor dispatches: threads (the default) or fibers"
    }
  },
  "toolchain": "ruby --version",
  "deferred": [
    "state_persistence",
    "effectively_once",
    "entity_timers",
    "correction_window",
    "keyed_channels",
    "workflow",
    "dynamic_entity",
    "entry_idle",
    "schema_evolution"
  ],
  "fixtures": {
    "runner_lifecycle": [
      "do_nothing",
      "compare_filter",
      "bench_echo"
    ],
    "connect_discovery": [
      "do_nothing"
    ],
    "graph_builder": [
      "sugar_do_nothing",
      "sugar_store_input",
      "sugar_static_entity",
      "static_entity",
      "mixed_operative",
      "hybrid_channel",
      "entity_stress",
      "bench_keyed_nopersist"
    ],
    "liveness": [
      "wedge_probe"
    ],
    "retry_ladder": [
      "poison_probe",
      "bounded_mailbox_drop_nothing",
      "bounded_mailbox_drop_newest",
      "bounded_mailbox_drop_oldest"
    ],
    "partitioned": [
      "partition_relay",
      "dynamic_entity"
    ],
    "pool_wedge": [
      "wedge_probe"
    ]
  },
  "docs": "docs/sdk/ruby_sdk.md"
}
