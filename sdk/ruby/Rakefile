# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs = %w[lib test]
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end

desc "Build the native veneer and install it where the gem loads it from"
task :native do
  sh File.expand_path("../../scripts/build-ruby-sdk.sh", __dir__)
end

desc "Build a platform gem carrying the compiled veneer, for this platform"
task native_gem: :native do
  require "fileutils"
  require "rubygems/package"

  spec = Gem::Specification.load("flezha.gemspec")
  spec.platform = Gem::Platform.local
  # The library is IN the gem, so there is nothing left to compile at install
  # time — which is the whole point of a platform gem.
  spec.extensions = []
  spec.files += Dir["lib/flezha/flz_core_ffi.*"]
  spec.required_ruby_version = ">= 3.3.0"

  FileUtils.mkdir_p("pkg")
  FileUtils.mv(Gem::Package.build(spec), "pkg/")
end

task default: :test
